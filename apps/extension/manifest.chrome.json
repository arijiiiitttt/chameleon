{
  "manifest_version": 3,
  "name": "Chameleon",
  "version": "0.1.0",
  "description": "Privacy-preserving on-device visual perception for a lightweight browser agent.",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Chameleon",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": [
    "http://localhost:8787/*",
    "http://127.0.0.1:8787/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["models/*.onnx", "*.wasm", "tesseract/*", "ort/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "src/options/index.html",
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}