# Copy this file to .env before running `npm run dev` or `npm run build:*`.
# Vite only exposes variables prefixed with VITE_ to client-side code -
# never put secrets here, since this ends up bundled into the extension
# and shipped to every user's browser (see docs/SECURITY.md - "Never put
# API keys into the extension").

# Base URL of the CHAMELEON reasoning server (apps/server). Defaults to
# the local dev server if unset.
VITE_SERVER_URL=http://localhost:8787

# Opt-in VLM (vision-language model) channel. When "true", one small,
# already pixel-redacted screenshot accompanies each sanitized request
# (see content-script.ts's buildRedactedScreenshot()) so a vision-capable
# server-side model can see overall page layout. Defaults to "false" -
# purely additive when enabled, and the corresponding server-side
# AI_VISION_ENABLED must also be "true" for the image to actually be used
# by the reasoning provider (see apps/server/.env.example).
VITE_VLM_ENABLED=true
