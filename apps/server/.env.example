PORT=8787

# "mock" runs entirely offline with no external AI API - the mock
# reasoning provider uses domain-independent word-overlap matching
# against interactive element labels (see src/providers/mock-provider.ts).
# "openai-compatible" requires AI_BASE_URL, AI_MODEL, AI_API_KEY below.
AI_PROVIDER=mock

AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Opt-in VLM (vision-language model) support. When "true", and the AI_PROVIDER
# is "openai-compatible", any incoming request that carries a client-side
# pixel-redacted screenshot (screen.redactedScreenshot) will have that image
# included as a real image_url content block sent to the model. Requires a
# vision-capable model at AI_MODEL - leave "false" (the default) for any
# text-only model, since sending an unexpected image block to a text-only
# endpoint is a real way to break requests.
AI_VISION_ENABLED=false

CORS_ORIGIN=*
MAX_REQUEST_BYTES=262144
